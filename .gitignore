# local server config (machine-specific; config.example.yaml is the template)
config.yaml

# Household roots this node trusts — written by `cairnctl init`. Machine-local
# state, not source: it names a real household and differs per deployment.
trusted-roots.txt

# Go
/cairnd
/agent
/cairnctl
*.db
*.db-shm
*.db-wal
cairn.db*

# Node / webapp
node_modules/
webapp/node_modules/
webapp/dist/
webapp/.svelte-kit/

# mise: per-machine overrides stay local; mise.toml itself is committed
mise.local.toml
.mise.local.toml

# Editor / OS
.DS_Store
*.log

# blob store (local data-plane stand-in)
cairn-blobs/

# Dev TLS material. The webapp needs a secure context to have crypto.subtle at
# all, so a LAN dev node needs HTTPS — but a self-signed keypair is per-machine
# and the key is unencrypted. Generate your own; see config.example.yaml.
tls/
